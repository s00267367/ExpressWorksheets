@endpoint = http://localhost:1610/api/v1/auth

###
# @name registerUser
POST {{endpoint}}/register HTTP/1.1
content-type: application/json
x-api-key: 1234567890

{
  "name": "John Doe",
  "email": "john2.doe@example.com",
  "password": "securepassword"
}

###
# @name registerUserShortPassword
POST {{endpoint}}/register HTTP/1.1
content-type: application/json
x-api-key: 1234567890

{
  "name": "John Doe",
  "email": "john2000.doe@example.com",
  "password": "idk"
}

###
# @name loginUser
POST {{endpoint}}/login HTTP/1.1
content-type: application/json
x-api-key: 1234567890

{
  "email": "john2.doe@example.com",
  "password": "securepassword"
}

###
@token = {{loginUser.response.body.token}}

###
# @name getME
GET {{endpoint}}/me HTTP/1.1
content-type: application/json
x-api-key: 1234567890
Authorization: Bearer {{token}}
